<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Version>2.78.1.899</Version>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\DB\DB.csproj" />
    <ProjectReference Include="..\RaceLib\RaceLib.csproj" />
    <ProjectReference Include="..\Sound\Sound.csproj" />
    <ProjectReference Include="..\Brackets\Brackets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="MonoGame.Framework.DesktopGL" />
  </ItemGroup>

  <!-- The API console (/api/v1/docs) ships inside the DLL so it needs no install step. -->
  <ItemGroup>
    <EmbeddedResource Include="Api\Console\*.*" LogicalName="Webb.Api.Console.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The Seeder web app (/seeder): SeederUI's Nuxt build, written to Seeder\UI
       by `npm run generate`. Not committed. The BuildSeederUI target below runs
       npm as part of the build; a build without npm serves a "not built" page.
       Pass -p:SkipSeederUI=true to skip the npm step. -->
  <PropertyGroup>
    <SeederUIDir>$(MSBuildThisFileDirectory)..\SeederUI\</SeederUIDir>
    <SeederUIOutDir>$(MSBuildThisFileDirectory)Seeder\UI\</SeederUIOutDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Seeder\UI\**" />
    <None Remove="Seeder\UI\**" />
    <SeederUISource Include="$(SeederUIDir)app\**\*.*;$(SeederUIDir)public\**\*.*;$(SeederUIDir)nuxt.config.ts;$(SeederUIDir)package.json;$(SeederUIDir)package-lock.json" />
  </ItemGroup>

  <!-- npm ci only when node_modules is missing or older than the lockfile. -->
  <Target Name="SeederUINpmCi" Condition="'$(SkipSeederUI)' != 'true' And Exists('$(SeederUIDir)package.json')"
          Inputs="$(SeederUIDir)package-lock.json" Outputs="$(SeederUIDir)node_modules\.package-lock.json">
    <Exec Command="npm --version" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="SeederNpmExitCode" />
    </Exec>
    <Warning Condition="'$(SeederNpmExitCode)' != '0'" Text="npm not found: the Seeder web app (/seeder) won't be built. Install Node.js, or pass -p:SkipSeederUI=true." />
    <Exec Condition="'$(SeederNpmExitCode)' == '0'" Command="npm ci" WorkingDirectory="$(SeederUIDir)" />
  </Target>

  <!-- npm run generate only when the SeederUI source is newer than the output. -->
  <Target Name="SeederUIGenerate"
          Condition="'$(SkipSeederUI)' != 'true' And Exists('$(SeederUIDir)node_modules')"
          Inputs="@(SeederUISource)" Outputs="$(SeederUIOutDir)index.html">
    <Exec Command="npm run generate" WorkingDirectory="$(SeederUIDir)" />
  </Target>

  <!-- Embed after generating: a glob at evaluation time would miss files the
       generate step just wrote, so the items are added inside a target. -->
  <Target Name="BuildSeederUI" BeforeTargets="BeforeBuild" DependsOnTargets="SeederUINpmCi;SeederUIGenerate">
    <ItemGroup>
      <_SeederUIFile Include="Seeder\UI\**\*.*" />
      <EmbeddedResource Include="@(_SeederUIFile)" LogicalName="Webb.SeederUI/%(_SeederUIFile.RecursiveDir)%(_SeederUIFile.Filename)%(_SeederUIFile.Extension)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Update="httpfiles\Accessor.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="httpfiles\background.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="httpfiles\EventManager.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="httpfiles\Formatter.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="httpfiles\Graph.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="httpfiles\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="httpfiles\linq.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="httpfiles\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="httpfiles\scroll.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="httpfiles\settings.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="httpfiles\style.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
